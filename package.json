{
  "name": "exist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "cd client && npm run build && cd ../server && npm run build",
    "start": "cd server && set NODE_ENV=production&& node dist/index.js",
    "start:unix": "cd server && NODE_ENV=production node dist/index.js",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "e2e": "playwright test",
    "e2e:cov": "cross-env E2E_COVERAGE=1 playwright test && node e2e/coverage/report.mjs",
    "e2e:report": "node e2e/coverage/report.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "better-sqlite3": "^12.10.0",
    "cross-env": "^7.0.3",
    "monocart-coverage-reports": "^2.12.0",
    "ws": "^8.21.0",
    "@types/ws": "^8.18.1",
    "@types/better-sqlite3": "^7.6.13"
  }
}
